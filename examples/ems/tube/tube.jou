reset
# Hollow tube: outer radius 1, inner radius 0.9 (thickness/radius = 0.1),
# height 2 (z in [-1, 1]).  Surface IDs after the boolean subtract are
# 1 (outer lateral), 7 (inner lateral), 8 (bottom cap), 9 (top cap).
create cylinder height 2 radius 1
create cylinder height 2 radius 0.9
subtract volume 2 from volume 1
volume 1 scheme tetmesh
volume 1 size 0.12
mesh volume 1
block 1 volume 1
block 1 element type tetra4
block 1 name "tube"
sideset 1 surface 1
sideset 1 name "outer"
sideset 2 surface 7
sideset 2 name "inner"
sideset 3 surface 8
sideset 3 name "bottom"
sideset 4 surface 9
sideset 4 name "top"
set large exodus file off
export mesh "tube.g" overwrite
