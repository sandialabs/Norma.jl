# Cubit 17.08 + Cubit 17.10.1
reset
undo off

open "embedded_fuze_fill_unmerged.cub"

# Unmerge the inner fill (d2) from the outer fill (d1)
unmerge volume in block 4 volume in block 3

# Remerge volumes
merge volume in block 3 4

# Need to be sidesets for current sierra version

#sideset 10 add surface 656 658 660 661 664 666 to 668 670 672 to 674 676 to 679 683 686 688 690 693 696 699 701 703 705 707 710
#sideset 20 add surface 219 225 233 241 246 248 252 257 259 264 266 271 294 301 326 328 356 358 386 388 394 401 406 408 416 418 424 431

#sideset 10 name "ss_exp_d1"
#sideset 20 name "ss_exp_d2"


export mesh "non_overlap_embedded_fuze_d1_fill_unmerged.g" block 1 2 5 overwrite  
export mesh "non_overlap_embedded_fuze_d2_fill_unmerged.g" block 3 4 overwrite

reset

import mesh geometry "non_overlap_embedded_fuze_d1_fill_unmerged.g" feature_angle 135 merge
delete volume 5 
delete block 5
delete nodeset all
nodeset 1 add node all
nodeset 1 name "nsall" 
nodeset 2 surface 30 
nodeset 2 name "ns_bottom_kase"
nodeset 3 surface 5 
nodeset 3 name "ns_lateral_kase"
nodeset 4 surface 2
nodeset 4 name "ns_top_kase"
nodeset 5 surface 10 
nodeset 5 name "ns_bottom_exp_d1" 
sideset 1 surface 11 12 13 
sideset 1 name "ss_exp_d1_schwarz" 
export mesh "case.g" overwrite

reset 
import mesh geometry "non_overlap_embedded_fuze_d2_fill_unmerged.g" feature_angle 135 merge
delete nodeset all 
nodeset 1 add node all
nodeset 1 name "nsall" 
nodeset 2 surface 1 
nodeset 2 name "ns_bottom_exp_d2" 
sideset 1 surface 4 5 40 
sideset 1 name "ss_egg_schwarz" 
export mesh "egg.g" overwrite







