${m = 1.0}
${mm = 0.001 * m}
${side = 1.0 * mm}
${length = 1.0 * m}
${h_size_face = 1.0 * mm}

# Interval counts chosen so that the two subdomains do NOT share the same
# axial element size at the overlap -- i.e. the interface is non-conformal.
# Coarse side:  h = 0.33 m / 110  = 0.0030000 m  (3.000 mm)
# Fine side:    h = 0.83 m / 415  = 0.0020000 m  (2.000 mm)
# The coarse element size is 1.5x the fine element size (50% larger), so
# nodes on the shared overlap region no longer line up between the coarse
# and fine meshes.
${intervals_coarse = 110}
${intervals_fine = 415}

# Two overlapping subdomains in the z direction.
# Left/coarse subdomain:  [-0.51, -0.18]   (shifted slightly from [-0.5, -0.2])
# Right/fine subdomain:   [-0.31,  0.52]   (shifted slightly from [-0.3, 0.5])
# Overlap:                [-0.31, -0.18]
# Because the endpoints were nudged and the interval counts no longer give
# matching element sizes, the two meshes are non-conformal across the
# overlap region (in both geometry and resolution).

${domain_length_coarse = 0.33 * m}
${domain_length_fine = 0.83 * m}
${center_coarse = -0.345 * m}
${center_fine = 0.105 * m}

create brick x {side} y {side} z {domain_length_coarse}
move volume 1 z {center_coarse} include_merged
surface 1 2 size {h_size_face}
surface 1 2 scheme submap
mesh surface 1 2
curve 9 10 11 12 interval {intervals_coarse}
mesh volume 1
block 1 volume 1
block 1 name "coarse"
nodeset 1 surface with x_coord < 0
nodeset 1 name "nsx-"
nodeset 2 surface with x_coord > 0
nodeset 2 name "nsx+"
nodeset 3 surface with y_coord < 0
nodeset 3 name "nsy-"
nodeset 4 surface with y_coord > 0
nodeset 4 name "nsy+"
#nodeset 5 surface with z_coord < 0
nodeset 5 surface 2
nodeset 5 name "nsz-"
#nodeset 6 surface with z_coord > 0
nodeset 6 surface 1
nodeset 6 name "nsz+"
nodeset 7 volume all
nodeset 7 name "nsall"
sideset 1 surface with x_coord < 0
sideset 1 name "ssx-"
sideset 2 surface with x_coord > 0
sideset 2 name "ssx+"
sideset 3 surface with y_coord < 0
sideset 3 name "ssy-"
sideset 4 surface with y_coord > 0
sideset 4 name "ssy+"
#sideset 5 surface with z_coord < 0
sideset 5 surface 2
sideset 5 name "ssz-"
#sideset 6 surface with z_coord > 0
sideset 6 surface 1
sideset 6 name "ssz+"
set large exodus file off
export mesh "clamped-smaller-1.g" overwrite

# Start from a fresh brick for the right/fine subdomain. Compressing IDs
# ensures the new brick again has volume ID 1, surfaces 1--6, and curves 1--12.
delete mesh
delete volume all
compress ids all
create brick x {side} y {side} z {domain_length_fine}
compress ids all
move volume 1 z {center_fine} include_merged
surface 1 2 size {h_size_face}
surface 1 2 scheme submap
mesh surface 1 2
curve 9 10 11 12 interval {intervals_fine}
mesh volume 1
block 1 volume 1
block 1 name "fine"
nodeset 1 surface with x_coord < 0
nodeset 1 name "nsx-"
nodeset 2 surface with x_coord > 0
nodeset 2 name "nsx+"
nodeset 3 surface with y_coord < 0
nodeset 3 name "nsy-"
nodeset 4 surface with y_coord > 0
nodeset 4 name "nsy+"
#nodeset 5 surface with z_coord < 0
nodeset 5 surface 2
nodeset 5 name "nsz-"
#nodeset 6 surface with z_coord > 0
nodeset 6 surface 1
nodeset 6 name "nsz+"
nodeset 7 volume all
nodeset 7 name "nsall"
sideset 1 surface with x_coord < 0
sideset 1 name "ssx-"
sideset 2 surface with x_coord > 0
sideset 2 name "ssx+"
sideset 3 surface with y_coord < 0
sideset 3 name "ssy-"
sideset 4 surface with y_coord > 0
sideset 4 name "ssy+"
#sideset 5 surface with z_coord < 0
sideset 5 surface 2
sideset 5 name "ssz-"
#sideset 6 surface with z_coord > 0
sideset 6 surface 1
sideset 6 name "ssz+"
set large exodus file off
export mesh "clamped-larger-2.g" overwrite
