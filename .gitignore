# julia manifest, do not push this
Manifest.toml

# Documenter generated site
docs/build/

# git ls-files --others --exclude-from=.git/info/exclude
# Lines that start with '#' are comments.
# For a project mostly in C, the following would be a good set of
# exclude patterns (uncomment them if you want to use them):
*.[oa]
/build*/
/build*
/sandbox/
.DS_Store
.vscode
*.e
*.exo
# Meshes written by the adaptivity loop and by the refinement stages of the plate example
*-adapted-*.g
examples/ems/plate/plate-stage-*.g
# MicroStructPy output of the polycrystal example
examples/crystal-plasticity/polycrystal/polycrystal-tets/
examples/crystal-plasticity/polycrystal/polycrystal-voxels/
CLAUDE.local.md

# Claude Code session data
.claude/

# Simulation log output
*.log

# CSV output artifacts
*.csv
# ROM training data (intentionally tracked)
!examples/ahead/overlap/cuboid/dynamic-cubic-opinf-rom/*.csv
# LCM reference data of the crystal plasticity and composite tet tests, in every subfolder (intentionally tracked)
!test/lcm-reference/**/*.csv

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.bbl
*.blg
!format/Manifest.toml

# Benchmark meshes, logs, and results
benchmark/*.g
benchmark/*.log
benchmark/results.txt
