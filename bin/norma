#!/bin/bash
# CLI entry point for Norma.jl
#
# Usage:
#   bin/norma input.yaml               (one thread)
#   bin/norma input.yaml --threads 8

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# Parse --threads flag (must be extracted before passing to Julia)
THREADS=""
JULIA_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --threads|-t)
            THREADS="$2"
            shift 2
            ;;
        *)
            JULIA_ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ -z "${JULIA_ARGS[*]}" ]]; then
    echo "Usage: norma <input.yaml> [--threads N]" >&2
    exit 1
fi

# Norma never runs with an automatic thread count: on a large node it sizes
# both thread pools to the hardware thread count and oversubscribes the linear
# solver. Without a flag the run is serial, and the flag is always passed so
# that a JULIA_NUM_THREADS setting in the environment cannot change that.
if [[ -z "$THREADS" ]]; then
    THREADS=1
elif [[ "${THREADS,,}" == auto* ]]; then
    echo "norma: --threads auto is not supported; pass an explicit count" >&2
    exit 1
fi
THREAD_FLAG="-t $THREADS"

# Size the OpenBLAS thread pool before Julia starts. Norma binds the BLAS
# thread count to the Julia thread count at startup, but OpenBLAS has already
# created its pool by then, one thread per two cores, and those idle threads
# stay visible in top. Setting the variable here keeps the pool itself at the
# requested size. A variable already in the environment is left alone, since
# Norma treats it as the user addressing the library directly.
if [[ -z "${OPENBLAS_NUM_THREADS:-}" && -z "${OMP_NUM_THREADS:-}" ]]; then
    export OPENBLAS_NUM_THREADS="${THREADS%%,*}"
fi

# Julia's worker threads sleep 100 µs after a parallel loop, and the serial
# parts of a step (the matrix bookkeeping, the coupling of the Schwarz
# iteration) last longer, so every loop that follows them waits for the
# workers to wake, and the operating system wakes them on other cores than the
# ones that hold their data. With the threads pinned to cores (JULIA_EXCLUSIVE)
# a coupled run of two subdomains of 45 000 and 14 700 unknowns took 22.3 s on
# 12 threads against 34.8, a Newmark run of 45 000 unknowns 1.62 s against
# 2.02, the explicit run of 110 592 hexahedra 2.25 s against 2.46, and the
# direct solver and the explicit case lost nothing (spinning workers, by
# contrast, slowed the direct solver by 8%). The threads are pinned to the
# first cores, so two threaded runs on one machine would share them: set
# JULIA_EXCLUSIVE=0 for the second, since a value in the environment is left
# alone.
if [[ "${THREADS%%,*}" -gt 1 && -z "${JULIA_EXCLUSIVE:-}" ]]; then
    export JULIA_EXCLUSIVE=1
fi

exec julia $THREAD_FLAG --project="$PROJECT_DIR" "$PROJECT_DIR/src/Norma.jl" "${JULIA_ARGS[@]}"
