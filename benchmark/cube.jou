#{n = 24}
reset
create brick x 0.1 y 0.1 z 0.1
volume all interval {n}
mesh volume all
block 1 volume 1
block 1 name "cube"
nodeset 1 surface with x_coord < 0
nodeset 1 name "nsx-"
nodeset 2 surface with x_coord > 0
nodeset 2 name "nsx+"
nodeset 3 surface with y_coord < 0
nodeset 3 name "nsy-"
nodeset 4 surface with y_coord > 0
nodeset 4 name "nsy+"
nodeset 5 surface with z_coord < 0
nodeset 5 name "nsz-"
nodeset 6 surface with z_coord > 0
nodeset 6 name "nsz+"
nodeset 7 volume all
nodeset 7 name "nsall"
set large exodus file off
export mesh "cube{n}.g" overwrite
