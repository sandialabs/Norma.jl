reset
create brick x 0.02 y 0.02 z 1.0
volume all size 0.0025
mesh volume all
block 1 volume 1
block 1 name "beam"
nodeset 5 surface with z_coord < 0
nodeset 5 name "nsz-"
nodeset 6 surface with z_coord > 0
nodeset 6 name "nsz+"
nodeset 7 volume all
nodeset 7 name "nsall"
set large exodus file off
export mesh "beam.g" overwrite
